<%- include('partials/header') %>
    <main class="page-content">
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="grid-link-list link-list">
             <% projects.forEach(project => { %>
             <li class="grid-link-element"><%= new Date(project.date).toLocaleString(undefined, { dateStyle:"medium", timeStyle:"short"})%>: <%= project.title %> (<%= project.organization_name %>)</li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>