<%- include('partials/header') %>

<main class="page-content">
    <h1>Categories</h1>
    <ul class="link-list">
        <% categories.forEach(category => { %>
           <li class="link-element with-help-buttons">
                 <a href="/category/<%= category.category_id %>" class="view-link">
                    <strong><%= category.name %></strong> 
                </a>
                <a href="/edit-category/<%= category.category_id %>" class="link-button">Edit Category</a>
            </li>
        <% }); %>
    </ul>
    <div class="centered-button">
        <a class="link-button" href="/new-category">Create New Category</a>
    </div>
</main>

<%- include('partials/footer') %>