<%- include('partials/header') %>
    <main class="page-content">
        <h1><%= project.title %></h1>
        <h2>Description</h2>
        <p><%= project.description %></p>
        <details open>
            <summary>Show details</summary>
            <pre><strong>Organization: </strong><a href="/organization/<%= project.organization_id %>" class="link-button"> <%= project.organization_name %> </a></pre>
            <pre><strong>Date: </strong> <span><%= new Date(project.date).toLocaleString(undefined, { dateStyle:"medium", timeStyle:"short"})%> </span></pre>
            <pre><strong>Location: </strong><span><%= project.location %></span></pre>
        </details>
        <h3>Categories:</h3>
        <ul class="link-list row-link-list">
            <% categories.forEach(category => {%>
                <a href="/category/<%= category.category_id %>" class="link-button">#<%= category.name %></a>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>