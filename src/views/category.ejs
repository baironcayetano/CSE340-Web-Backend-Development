<%- include('partials/header') %>

<main class="page-content">
    <h1><%= category.name %></h1>
    <ul class="link-list">
        <% projects.forEach(project => { %>
           <li class="link-element">
                <a href="/project/<%= project.project_id %>">
                    <span><%= project.title %></span>
                </a>
           </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>