<%- include("partials/header") %>
    <main class="page-content">
        <h1><%= title %></h1>
        <form action="/edit-project/<%= projectDetails.project_id %>" method="post">
            <div class="form-group">
                <label for="title">Project Name:</label>
                <input type="text" name="title" id="title" value="<%= projectDetails.title %>" required maxlength="150">
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea name="description" id="description" required maxlength="500"><%= projectDetails.description %></textarea>
            </div>
            <div class="form-group">
                <label for="location">Location:</label>
                <textarea name="location" id="location" required maxlength="255"><%=  projectDetails.location %></textarea>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <input type="datetime-local" name="date" id="date" value="<%= projectDetails.date %>" required>
            </div>
            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select name="organizationId" id="organizationId" required>
                    <option value="<%= projectDetails.organization_id %>">
                        <% const ownerOrganization = organizations.filter((organization) => organization.organization_id === projectDetails.organization_id)[0] %>
                        <%= ownerOrganization.name %> 
                    </option>
                    <% organizations.forEach((organization) => { %>
                        <% if(organization.organization_id !== projectDetails.organization_id){ %>
                            <option value="<%= organization.organization_id%>"> 
                                <%= organization.name %>
                            </option>
                        <%}%>
                    <%});%>
                </select>
            </div>
            <div class="centered-button">
                <button type="submit" class="submit-button" title="update project">Update Project</button>
            </div>
        </form>
    </main>
<%- include("partials/footer") %>