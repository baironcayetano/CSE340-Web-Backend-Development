<%- include("partials/header") %>
<main class="page-content">
    <h1><%= title %></h1>
    <form method="post" action="/edit-category/<%= category.category_id %>">
        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" value="<%= category.name %>" required maxlength="100">
        </div>
        <button type="submit" class="submit-button" title="edit category">Edit Category</button>
    </form>
</main>
<%- include("partials/footer") %>