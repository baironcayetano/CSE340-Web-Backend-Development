<%- include('partials/header') %>

    <main class="page-content">
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul class="link-list">
            <% organizations.forEach(organization => { %>
            <li class="link-element organization">
                <a href="/organization/<%= organization.organization_id %>" class="organization-link">
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <span><%= organization.name %></span>
                    <span><%= organization.contact_email %></span>
                </a>
                <a href="/edit-organization/<%= organization.organization_id %>" class="link-button">Edit organization</a>
            </li>
            <% }); %>
        </ul>
        <p><a href="/new-organization" class="link-button">Add a new organization</a></p>
    </main>

<%- include('partials/footer') %>